# Frontend E-Tex 360 — instancia ${INSTANCIA} (generado por crear-instancia.sh)
# El build es el mismo para todas las instancias: la API se llama por ruta relativa /api/v1
# (nginx la enruta por dominio). API_INTERNAL_URL la usan las rutas que corren en el servidor de Next.
NODE_ENV=production
PORT=${PUERTO_FRONT}
HOSTNAME=0.0.0.0
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://127.0.0.1:${PUERTO_API}/api/v1
