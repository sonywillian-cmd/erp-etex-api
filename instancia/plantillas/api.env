# API E-Tex 360 — instancia ${INSTANCIA} (generado por crear-instancia.sh)
NODE_ENV=production
PORT=${PUERTO_API}

DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_USER=${DB_USER}
DB_PASS=${DB_PASS}
DB_NAME=${DB_NAME}

JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=12h
CONFIG_CIPHER_KEY=${CONFIG_CIPHER_KEY}

# Dominio público de la instancia (también alimenta CORS)
FRONTEND_URL=https://${DOMINIO}
CORS_ORIGINS=

# Archivos subidos (fotos de gastos, facturas de compra, empleados) y respaldos
UPLOADS_DIR=${DIR_INSTANCIA}/uploads
UPLOADS_BASE_URL=https://${DOMINIO}/uploads
BACKUP_DIR=${DIR_INSTANCIA}/backups

# Bot de Telegram (el token y Gemini se administran desde Ajustes; aquí solo el secreto compartido)
TELEGRAM_BOT_SHARED_SECRET=${TELEGRAM_BOT_SHARED_SECRET}
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
GEMINI_API_KEY=${GEMINI_API_KEY}
GEMINI_MODEL=${GEMINI_MODEL}
