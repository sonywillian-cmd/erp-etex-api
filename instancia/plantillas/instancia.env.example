# ═══ Datos de la instancia (uno por cliente) — lo lee crear-instancia.sh ═══
INSTANCIA=printex                       # slug: solo letras, números y guiones
EMPRESA_NOMBRE="MCH PRINTEX"            # nombre de la empresa (razón social; se ajusta luego en Ajustes)
DOMINIO=printex.etex360.com             # dominio público de esta instancia

# Dónde viven el código compartido y las carpetas de la instancia
CODIGO_API=/home/etex/apps/api          # dist de la API (compartido por todas las instancias)
CODIGO_FRONT=/home/etex/apps/frontend   # standalone de Next (compartido)
CODIGO_BOT=/home/etex/apps/telegram-bot # bot.js (compartido)
BASE_DIR=/home/etex/instancias          # aquí se crea $BASE_DIR/$INSTANCIA con env, uploads y backups

# Puertos internos (nginx los enruta por dominio)
PUERTO_API=3011
PUERTO_FRONT=3010

# Base de datos MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=etex_printex
DB_USER=etex_printex
DB_PASS="CAMBIAR_clave_larga_de_la_bd"      # entre comillas si lleva símbolos
# Si se indica, el script crea la BD y el usuario (VPS propio). En hosting compartido déjalo vacío
# y crea la BD en hPanel antes.
MYSQL_ROOT_PASS=""

# Primer usuario administrador (entra con contraseña temporal y debe cambiarla)
ADMIN_EMAIL=admin@printex.com.do
ADMIN_NOMBRE="Administrador Printex"
ADMIN_PASSWORD="CAMBIAR_temporal_2026"

# Opcionales: si se dejan vacíos se configuran luego desde Ajustes → Bot de Telegram
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
