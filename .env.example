# ─── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=tu_password_aqui
DB_NAME=erp_etex

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS (URL del frontend) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Orígenes CORS adicionales, separados por coma (los que empiezan por ^ se tratan como regex)
CORS_ORIGINS=

# ─── Rutas de la instancia (cambian por cliente) ──────────────────────────────
# Carpeta pública de archivos subidos y su URL (por defecto FRONTEND_URL + /uploads)
UPLOADS_DIR=/home/USUARIO/domains/DOMINIO/public_html/uploads
UPLOADS_BASE_URL=https://DOMINIO/uploads
# Carpeta de respaldos (por defecto ~/backups)
BACKUP_DIR=/home/USUARIO/backups
